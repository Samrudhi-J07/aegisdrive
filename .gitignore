# ─────────────────────────────────────────
# PYTHON
# ─────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# ─────────────────────────────────────────
# SECRETS — NEVER COMMIT
# ─────────────────────────────────────────
.env
.env.local
.env.*.local
*.key
secrets.json

# ─────────────────────────────────────────
# NODE / REACT
# ─────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─────────────────────────────────────────
# DATA — keep small CSVs, exclude large/processed
# ─────────────────────────────────────────
data/uploads/
data/processed/
data/features/
data/raw/*.csv
!data/raw/indian_roads_dataset.csv

# ─────────────────────────────────────────
# ML MODELS (regenerate or use Git LFS)
# ─────────────────────────────────────────
models/*.pkl
models/*.h5
models/*.joblib

# ─────────────────────────────────────────
# NOTEBOOKS
# ─────────────────────────────────────────
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# ─────────────────────────────────────────
# IDE / OS
# ─────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ─────────────────────────────────────────
# LOGS
# ─────────────────────────────────────────
*.log
logs/
mlruns/
reports/*.pdf
